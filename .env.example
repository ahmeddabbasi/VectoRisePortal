# ── Environment ──────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
SEED_DATABASE=true

# ── Database ───────────────────────────────────────────────
# Development (SQLite):
DATABASE_URL=sqlite:///./backend/data/dashboard.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://vectorise:changeme@db:5432/vectorise

# ── Security (REQUIRED in production) ───────────────────────
JWT_SECRET=generate-a-long-random-secret-here
JWT_EXPIRE_MINUTES=480

# ── Admin bootstrap (used only when SEED_DATABASE=true) ─────
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=use-a-strong-password

# ── CORS (comma-separated frontend origins) ─────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Google Sheets sync (optional) ───────────────────────────
GOOGLE_SPREADSHEET_ID=1WyXufFOy6Q37oEoyf6a5C7Yk46SzYGjDqXOhj9OKzVI
GOOGLE_SERVICE_ACCOUNT_PATH=./credentials/google-service-account.json
# Cloud deploy (Render): paste full JSON instead of a file path
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
SYNC_INTERVAL_MINUTES=15
ENABLE_SYNC_SCHEDULER=true

# ── Scheduled jobs (UTC) ────────────────────────────────────
DAILY_JOBS_HOUR=23
DAILY_JOBS_MINUTE=0

# ── File uploads ────────────────────────────────────────────
UPLOAD_DIR=./backend/uploads
MAX_UPLOAD_MB=5

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
